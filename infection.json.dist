{
    "timeout": 10,
    "tmpDir": "var/infection",
    "source": {
        "directories": [
            "src\/"
        ]
    },
    "logs": {
        "text": "var/infection.log"
    },
    "mutators": {
        "@default": true,
        "ArrayItemRemoval": {
            "settings": {
                "remove": "all"
            }
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "phpUnit": {
        "configDir": "."
    }
}
